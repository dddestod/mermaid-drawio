{
  "name": "mermaid-drawio",
  "version": "0.1.0",
  "private": true,
  "description": "Convert a rendered Mermaid flowchart, state, ER or class diagram SVG into an editable draw.io diagram, keeping Mermaid's layout and styling.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "test:skill": "node --test test/skill.test.mjs",
    "test:skill:export": "node --test test/skill-export.test.mjs",
    "check": "tsc --noEmit",
    "fixtures": "node scripts/render-fixtures.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitest/browser": "^3.2.7",
    "esbuild": "^0.25.12",
    "jsdom": "^26.1.0",
    "mermaid": "12.2.0",
    "playwright": "^1.64.1",
    "typescript": "~5.6.2",
    "vite": "^6.4.4",
    "vitest": "^3.2.7"
  }
}
